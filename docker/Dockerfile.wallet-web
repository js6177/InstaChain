FROM oven/bun:1.3.3 AS base
WORKDIR /app

FROM base AS pruner
COPY . .
RUN bunx turbo@2.8.14 prune web --docker

FROM base AS installer
COPY --from=pruner /app/out/json/ .
RUN bun install --no-save
COPY --from=pruner /app/out/full/ .

FROM installer AS builder
# utils.ts is gitignored by root `lib/` until committed; copy from build context for turbo prune
COPY frontend/wallet/apps/web/src/lib ./frontend/wallet/apps/web/src/lib
# Vite reads VITE_* from .env.production at build time (not compose env_file at runtime)
COPY frontend/wallet/.env.docker ./frontend/wallet/apps/web/.env.production
WORKDIR /app/frontend/wallet/apps/web
RUN bun run build

FROM nginx:1.27-alpine AS runner
COPY docker/nginx.wallet-web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/frontend/wallet/apps/web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

FROM installer AS dev
WORKDIR /app/frontend/wallet/apps/web
EXPOSE 5173
CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
