FROM oven/bun:1.3.3 AS builder

WORKDIR /app

COPY package.json bun.lock ./
COPY backend/layer2ledgeroauthmanager/package.json ./backend/layer2ledgeroauthmanager/
COPY shared/pubkey-utils/package.json ./shared/pubkey-utils/
COPY shared/config-loader/package.json ./shared/config-loader/

RUN bun install --frozen-lockfile

COPY shared/pubkey-utils ./shared/pubkey-utils
COPY shared/config-loader ./shared/config-loader
COPY backend/layer2ledgeroauthmanager ./backend/layer2ledgeroauthmanager

FROM oven/bun:1.3.3 AS builder

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/backend/layer2ledgeroauthmanager ./backend/layer2ledgeroauthmanager
COPY --from=builder /app/shared ./shared
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/bun.lock ./bun.lock

WORKDIR /app/backend/layer2ledgeroauthmanager

ENV ENVIRONMENT=dev
ENV OPENL2_OAUTH_CONFIG_PATH=/app/config/config.json

EXPOSE 4000

CMD ["bun", "run", "dev"]
