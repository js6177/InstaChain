FROM oven/bun:1.3.3 AS base
WORKDIR /app

FROM base AS pruner
COPY . .
RUN bunx turbo@2.8.14 prune @openl2/bitcoin-core-rpc @openl2/pubkey-utils --docker

FROM base AS installer
COPY --from=pruner /app/out/json/ .
RUN bun install --no-save
COPY --from=pruner /app/out/full/ .

FROM oven/bun:1.3.3-slim AS runner
WORKDIR /app
COPY --from=installer /app .
COPY docker/test_bitcoin_core_rpc_entrypoint.ts /usr/local/bin/test_bitcoin_core_rpc_entrypoint.ts
CMD ["bun", "/usr/local/bin/test_bitcoin_core_rpc_entrypoint.ts"]
