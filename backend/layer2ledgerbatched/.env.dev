POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=layer2ledgerbatched_dev
POSTGRES_HOST=layer2ledger-postgres
POSTGRES_PORT=5432

REDIS_HOST=layer2ledger-redis
REDIS_PORT=6379

# Application Configuration (using variables above)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# Port Configuration
LAYER2LEDGER_FASTAPI_PORT=8000
LAYER2LEDGER_APIHANDLER_DEBUG_PORT=5678
LAYER2LEDGER_DBWRITER_DEBUG_PORT=5679