{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/"],
            "python": "${command:python.interpreterPath}",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python Debugger: layer2ledgerapihandler",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/layer2ledgerbatched/layer2ledgerapihandler/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python Debugger: layer2ledgerdbwriter",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/layer2ledgerbatched/layer2ledgerdbwriter/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python Debugger: main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Attach: layer2ledgerapihandler (Docker)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "/app/layer2ledgerbatched/src"
                },
                {
                    "localRoot": "${workspaceFolder}/../packages",
                    "remoteRoot": "/app/packages"
                }
            ],
            "justMyCode": true
        },
        {
            "name": "Attach: layer2ledgerdbwriter (Docker)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 5679
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "/app/layer2ledgerbatched/src"
                },
                {
                    "localRoot": "${workspaceFolder}/../packages",
                    "remoteRoot": "/app/packages"
                }
            ],
            "justMyCode": true
        }
    ]
}