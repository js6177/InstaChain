POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=layer2ledger_prod
POSTGRES_HOST=layer2ledger-postgres
POSTGRES_PORT=5432

REDIS_HOST=layer2ledger-redis
REDIS_PORT=6379

# Application Configuration (using variables above)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# Port Configuration
LAYER2LEDGER_FASTAPI_PORT=8000
BITCOIN_RPC_HOST=bitcoin-core
BITCOIN_RPC_IMPORT_HOST=127.0.0.1
BITCOIN_RPC_PORT=8334
LAYER2LEDGER_APIHANDLER_HOST=layer2ledgerapihandler