POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=layer2ledger_dev
POSTGRES_HOST=layer2ledger-postgres
POSTGRES_PORT=5432

# PgBouncer (transaction pooling) — used by apihandler; dbwriter stays on POSTGRES_HOST.
PGBOUNCER_HOST=layer2ledger-pgbouncer
PGBOUNCER_PORT=6432

# Locks, pending queues, bloom filters.
REDIS_TRANSACTIONS_HOST=redis-transactions
REDIS_TRANSACTIONS_PORT=6379
# Address-balance cache only.
REDIS_ADDRESSBALANCE_HOST=redis-addressbalance
REDIS_ADDRESSBALANCE_PORT=6379
# Profiler sessions and diagnostic app data (test/dev only).
REDIS_DIAGNOSTICS_HOST=redis-diagnostics
REDIS_DIAGNOSTICS_PORT=6379

# Application Configuration (using variables above)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_TRANSACTIONS_URL=redis://${REDIS_TRANSACTIONS_HOST}:${REDIS_TRANSACTIONS_PORT}
REDIS_ADDRESSBALANCE_URL=redis://${REDIS_ADDRESSBALANCE_HOST}:${REDIS_ADDRESSBALANCE_PORT}
REDIS_DIAGNOSTICS_URL=redis://${REDIS_DIAGNOSTICS_HOST}:${REDIS_DIAGNOSTICS_PORT}

# Port Configuration
LAYER2LEDGER_FASTAPI_PORT=8000
TESTHELPER_PORT=8001
LAYER2LEDGER_APIHANDLER_DEBUG_PORT=5678
LAYER2LEDGER_DBWRITER_DEBUG_PORT=5679
BITCOIN_RPC_HOST=bitcoin-core
BITCOIN_RPC_IMPORT_HOST=127.0.0.1
BITCOIN_RPC_PORT=8334
LAYER2LEDGER_APIHANDLER_HOST=layer2ledgerapihandler
