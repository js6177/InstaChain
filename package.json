{
	"name": "openl2-repo",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"backend/*",
		"backend/packages/*",
		"frontend/**/*",
		"shared/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"setup": "bun run --filter @openl2/setup-scripts setup",
		"setup:first-time": "bun run --filter @openl2/setup-scripts setup:first-time",
		"test:docker": "bun run --filter @openl2/setup-scripts test:docker",
		"uninstall": "bun run --filter @openl2/setup-scripts uninstall"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@types/bun": "latest",
		"@vitest/coverage-istanbul": "4.1.9",
		"tsx": "^4.22.0",
		"turbo": "^2.8.14"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"overrides": {
		"elysia": "1.4.29",
		"@elysiajs/eden": "1.4.9",
		"@elysiajs/cors": "1.4.2"
	}
}
