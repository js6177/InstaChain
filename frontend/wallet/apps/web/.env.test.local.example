# Local Vitest integration tests (copy to .env.test.local — gitignored).
# Requires backend: `make backend-test` from the repo root (includes testhelper on :8001).
#
# Vitest runs on the host — use localhost URLs (published container ports).
# Bridge signing key is read from .config/test/layer2ledgerbridge-config.json.

VITE_API_BASE_URL=http://localhost:8000
VITE_LAYER2_OAUTH_API_URL=http://localhost:4000
VITE_TESTHELPER_BASE_URL=http://localhost:8001
VITE_APP_ORIGIN=http://localhost:5173
