{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Vite in Chrome",
            "url": "http://localhost:5173",
            "userDataDir": "/home/js/.config/google-chrome/Profile 1",
            "runtimeArgs": [
                "--profile-directory=Profile 1"
            ],
            "webRoot": "${workspaceFolder}/apps/web",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "/src/*": "${workspaceFolder}/apps/web/src/*",
                "/@fs/*": "*",
                "../src/*": "${workspaceFolder}/apps/web/src/*"
            },
            "resolveSourceMapLocations": [
                "${workspaceFolder}/apps/web/**",
                "!**/node_modules/**"
            ]
        },
        {
            "type": "chrome",
            "request": "attach",
            "name": "Attach to Chrome",
            "port": 9222,
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}"
        }
        
    ]
}